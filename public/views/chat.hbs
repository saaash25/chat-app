<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="/assets/bootstrap/bootstrap.min.css">
    <link rel="stylesheet" href="/css/style.css">
    <title>Chat App - Direct Messages & Rooms</title>
</head>

<body>
    <!-- Toast Notification Container -->
    <div id="toastContainer" class="toast-container-custom"></div>

    <!-- Mobile Sidebar Backdrop -->
    <div class="sidebar-backdrop" id="sidebarBackdrop"></div>

    <div class="chat-app-container">
        <!-- Sidebar Navigation -->
        <aside class="chat-sidebar" id="chatSidebar">
            <div class="sidebar-header">
                <div class="brand-row">
                    <div class="brand-badge">
                        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"></path>
                        </svg>
                        <span>PulseChat</span>
                    </div>
                    <span class="pulse-indicator" id="socketStatusIndicator" title="Connected"></span>
                </div>

                <!-- Navigation Switcher: Direct Chat vs Chat Rooms -->
                <div class="sidebar-nav-tabs">
                    <button type="button" class="sidebar-tab-btn active" id="tabDirectBtn" onclick="switchSidebarTab('direct')">
                        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path><circle cx="12" cy="7" r="4"></circle></svg>
                        <span>Direct Chat</span>
                        <span class="sidebar-tab-badge" id="onlineUsersCountBadge">0</span>
                    </button>
                    <button type="button" class="sidebar-tab-btn" id="tabRoomsBtn" onclick="switchSidebarTab('rooms')">
                        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path><circle cx="9" cy="7" r="4"></circle><path d="M23 21v-2a4 4 0 0 0-3-3.87"></path><path d="M16 3.13a4 4 0 0 1 0 7.75"></path></svg>
                        <span>Chat Rooms</span>
                    </button>
                </div>
            </div>

            <!-- Panel 1: Direct Messages Search & Active Users List -->
            <div id="directMessagesPanel" class="d-flex flex-column flex-grow-1 overflow-hidden">
                <div class="sidebar-search-box">
                    <div class="search-input-wrapper">
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><circle cx="11" cy="11" r="8"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line></svg>
                        <input type="text" id="userSearchInput" class="sidebar-search-input" placeholder="Search by name or phone...">
                    </div>
                    <div class="active-filter-row">
                        <span>Filter Active:</span>
                        <div class="form-check form-switch m-0">
                            <input class="form-check-input" type="checkbox" id="activeOnlyToggle">
                            <label class="form-check-label" for="activeOnlyToggle" style="font-size: 0.75rem;">Active Only</label>
                        </div>
                    </div>
                </div>

                <div class="sidebar-content-area" id="directUsersList">
                    <!-- Populated dynamically with registered users or loading state -->
                    <div class="p-3 text-center text-muted" id="directUsersLoading">
                        <div class="spinner-border spinner-border-sm text-primary mb-2" role="status"></div>
                        <div style="font-size: 0.8rem;">Loading contacts...</div>
                    </div>
                </div>
            </div>

            <!-- Panel 2: Chat Rooms Panel -->
            <div id="chatRoomsPanel" class="d-flex flex-column flex-grow-1 overflow-hidden d-none">
                <div class="sidebar-content-area">
                    <div class="d-flex align-items-center justify-content-between mb-2 px-1">
                        <h6 class="sidebar-section-title p-0 m-0">Available Rooms</h6>
                    </div>
                    <div id="availableRoomsList">
                        <div class="room-card-item" onclick="joinRoomByName('General')">
                            <div class="room-item-title">
                                <span>#</span> General
                            </div>
                            <span class="badge bg-light text-dark border">Join</span>
                        </div>
                        <div class="room-card-item" onclick="joinRoomByName('Tech')">
                            <div class="room-item-title">
                                <span>#</span> Tech
                            </div>
                            <span class="badge bg-light text-dark border">Join</span>
                        </div>
                        <div class="room-card-item" onclick="joinRoomByName('Cricket')">
                            <div class="room-item-title">
                                <span>#</span> Cricket
                            </div>
                            <span class="badge bg-light text-dark border">Join</span>
                        </div>
                        <div class="room-card-item" onclick="joinRoomByName('Football')">
                            <div class="room-item-title">
                                <span>#</span> Football
                            </div>
                            <span class="badge bg-light text-dark border">Join</span>
                        </div>
                        <div class="room-card-item" onclick="joinRoomByName('Political')">
                            <div class="room-item-title">
                                <span>#</span> Political
                            </div>
                            <span class="badge bg-light text-dark border">Join</span>
                        </div>
                    </div>

                    <!-- Custom Room Joiner -->
                    <div class="mt-3 p-2 bg-white rounded border">
                        <label class="form-label mb-1" style="font-size: 0.75rem;">Custom Room</label>
                        <div class="input-group input-group-sm">
                            <input type="text" id="customRoomInput" class="form-control" placeholder="Room name...">
                            <button type="button" class="btn btn-primary" onclick="joinCustomRoom()">Join</button>
                        </div>
                    </div>

                    <!-- Active Users In Room (Preserves test assertions) -->
                    <div class="mt-3" id="usersList">
                        <h6 class="sidebar-section-title px-1">Active Users</h6>
                        <div id="usersListUl">
                            <!-- Populated with room members -->
                        </div>
                    </div>
                </div>
            </div>

            <!-- Profile Footer Bar (Shows Name, Phone Number, and Icon) -->
            <div class="sidebar-footer-profile" id="userProfileBar">
                <div class="profile-card">
                    <div class="profile-avatar-circle" id="myProfileAvatar">U</div>
                    <div class="profile-details">
                        <span class="profile-name" id="myProfileName">User</span>
                        <span class="profile-phone" id="myProfilePhone">
                            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path></svg>
                            <span id="myProfilePhoneText">+1000000000</span>
                        </span>
                    </div>
                </div>
                <button type="button" class="btn-signout" onclick="handleSignOut()" title="Sign Out">Sign Out</button>
            </div>
        </aside>

        <!-- Main Chat Area -->
        <main class="chat-main" id="chatMainContainer">
            <!-- 1. Welcoming Screen (Shown when no conversation is selected) -->
            <div class="welcoming-screen" id="welcomingScreen">
                <div class="welcoming-hero-icon">
                    <svg width="36" height="36" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"></path>
                    </svg>
                </div>
                <h3 class="welcoming-title" id="welcomeUserHeading">Welcome to PulseChat!</h3>
                <p class="welcoming-subtitle">
                    Select an active contact from Direct Messages or choose a Chat Room from the sidebar to start a real-time conversation.
                </p>

                <div class="welcoming-actions-grid">
                    <div class="welcoming-card" onclick="switchSidebarTab('direct')">
                        <div class="welcoming-card-icon">
                            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path><circle cx="12" cy="7" r="4"></circle></svg>
                        </div>
                        <h6>Direct 1-on-1 Chat</h6>
                        <p>Search registered users by name or mobile number and send messages & photos.</p>
                    </div>

                    <div class="welcoming-card" onclick="switchSidebarTab('rooms')">
                        <div class="welcoming-card-icon">
                            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path><circle cx="9" cy="7" r="4"></circle><path d="M23 21v-2a4 4 0 0 0-3-3.87"></path><path d="M16 3.13a4 4 0 0 1 0 7.75"></path></svg>
                        </div>
                        <h6>Join Chat Rooms</h6>
                        <p>Participate in group topics like #General, #Tech, #Cricket, or create custom rooms.</p>
                    </div>
                </div>
            </div>

            <!-- 2. Active Chat Header (Hidden in welcoming state) -->
            <header class="chat-header d-none" id="activeChatHeader">
                <div class="d-flex align-items-center gap-3">
                    <button class="mobile-menu-toggle" id="menuToggle" aria-label="Toggle user menu">
                        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <line x1="3" y1="12" x2="21" y2="12"></line>
                            <line x1="3" y1="6" x2="21" y2="6"></line>
                            <line x1="3" y1="18" x2="21" y2="18"></line>
                        </svg>
                    </button>
                    <div>
                        <div class="header-title-badge">
                            <h5 class="header-chat-title" id="chatboxHead">Direct Messages</h5>
                            <span class="header-type-pill pill-direct" id="chatTypeBadge">Direct Message</span>
                        </div>
                        <div class="header-meta-phone" id="headerMetaText">Select a user to chat directly</div>
                    </div>
                </div>

                <div class="d-flex align-items-center gap-2">
                    <div class="user-avatar-circle" id="recipientHeaderAvatar" style="width: 34px; height: 34px; font-size: 0.85rem;">U</div>
                    <span class="user-name-text d-none d-sm-inline fw-semibold text-secondary" id="recipientHeaderName">Recipient</span>
                    <button type="button" class="btn-close-conversation" onclick="closeActiveConversation()" title="Back to welcome screen">
                        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg>
                        <span class="d-none d-md-inline">Close</span>
                    </button>
                </div>
            </header>

            <!-- 3. Chat Messages Scroll Pane (Hidden in welcoming state) -->
            <div class="chat-messages-container d-none" id="chatMessageDiv">
                <!-- Dynamically populated messages -->
            </div>

            <!-- 4. Image Staging Preview -->
            <div class="image-staging-bar" id="imageStagingBar">
                <img id="imageStagingThumb" class="image-staging-thumb" alt="Preview">
                <span class="image-staging-name" id="imageStagingName">image.png</span>
                <button type="button" class="btn-remove-staging" onclick="clearStagedImage()" title="Remove image">&times;</button>
            </div>

            <!-- 5. Input Bar (Hidden in welcoming state) -->
            <div class="chat-input-bar d-none" id="chatInputBar">
                <form id="messageForm" autocomplete="off">
                    <div class="input-container">
                        <!-- Image Upload Button -->
                        <input type="file" id="imageInput" accept="image/*" class="d-none">
                        <button type="button" class="btn-icon-action btn-action-tool" id="btnAttachImage" title="Attach an image">
                            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <rect x="3" y="3" width="18" height="18" rx="2" ry="2"></rect>
                                <circle cx="8.5" cy="8.5" r="1.5"></circle>
                                <polyline points="21 15 16 10 5 21"></polyline>
                            </svg>
                        </button>

                        <!-- Location Button -->
                        <button type="button" class="btn-icon-action btn-action-tool" id="sendLocation" title="Share your location">
                            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path>
                                <circle cx="12" cy="10" r="3"></circle>
                            </svg>
                        </button>

                        <input type="text" name="message" id="message" class="chat-input-field" placeholder="Type a message..." autofocus>

                        <button type="submit" class="btn-icon-action btn-send" id="sendMessage" title="Send message">
                            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                                <line x1="22" y1="2" x2="11" y2="13"></line>
                                <polygon points="22 2 15 22 11 13 2 9 22 2"></polygon>
                            </svg>
                        </button>
                    </div>
                </form>
            </div>
        </main>
    </div>

    <script type="text/javascript" src="/socket.io/socket.io.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/handlebars@latest/dist/handlebars.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/moment.js/2.29.1/moment.min.js"
        integrity="sha512-qTXRIMyZIFb8iQcfjXWCO8+M5Tbc38Qi5WzdPOYZHIlZpzBHG3L3by84BBBOiRGiEb7KKtAOAs5qYdUiZiQNNQ=="
        crossorigin="anonymous" referrerpolicy="no-referrer"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/qs/6.10.1/qs.min.js"
        integrity="sha512-aTKlYRb1QfU1jlF3k+aS4AqTpnTXci4R79mkdie/bp6Xm51O5O3ESAYhvg6zoicj/PD6VYY0XrYwsWLcvGiKZQ=="
        crossorigin="anonymous" referrerpolicy="no-referrer"></script>
    <script src="/js/chat.js"></script>
</body>

</html>
