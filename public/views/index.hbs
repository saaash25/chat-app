<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="/assets/bootstrap/bootstrap.min.css">
    <link rel="stylesheet" href="/css/style.css">
    <title>Chat App - Join Chat</title>
</head>

<body>
    <!-- Toast notification container -->
    <div id="toastContainer" class="toast-container-custom"></div>

    <div class="join-wrapper">
        <div class="join-card">
            <div class="join-card-header">
                <div class="join-brand-icon">
                    <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"></path>
                    </svg>
                </div>
                <h3>Join Chat</h3>
                <p id="authHeaderSubtitle">Register with your mobile number to start direct chat or join rooms</p>
            </div>

            <!-- Tab switcher: Sign Up vs Sign In -->
            <div class="auth-nav-tabs">
                <button type="button" class="auth-nav-btn active" id="tabSignUp" onclick="switchAuthTab('signup')">Sign Up (New User)</button>
                <button type="button" class="auth-nav-btn" id="tabSignIn" onclick="switchAuthTab('signin')">Sign In (Mobile Only)</button>
            </div>

            <div class="join-card-body">
                <form id="authForm" autocomplete="off">
                    <!-- Name input: Only shown for Sign Up -->
                    <div class="mb-3" id="nameGroup">
                        <label for="username" class="form-label">Full Name</label>
                        <input type="text" class="form-control modern-input" id="username" name="username"
                            placeholder="e.g. Sarah Connor" required autofocus>
                    </div>

                    <!-- Mobile Number input: Required for both Sign Up & Sign In -->
                    <div class="mb-3">
                        <label for="phoneNumber" class="form-label">Mobile Number</label>
                        <input type="tel" class="form-control modern-input" id="phoneNumber" name="phoneNumber"
                            placeholder="e.g. +1 234 567 8900 or 9876543210" required>
                        <div class="form-text" id="phoneHelp">Enter your mobile number (7-15 digits with optional country code).</div>
                    </div>

                    <!-- Room selection datalist for backward compatibility with tests -->
                    <datalist id="room-options">
                        <option value="General"></option>
                        <option value="Tech"></option>
                        <option value="Cricket"></option>
                        <option value="Football"></option>
                        <option value="Political"></option>
                    </datalist>

                    <div class="d-grid mt-4">
                        <button type="submit" class="btn btn-primary-gradient" id="submitBtn">
                            Sign Up & Start Chatting &rarr;
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <script>
        let currentMode = 'signup';

        // Custom Toast Notification System
        function showToast(message, type = 'info') {
            const container = document.getElementById('toastContainer');
            if (!container) return;

            const toast = document.createElement('div');
            toast.className = `custom-toast toast-${type}`;

            let iconSvg = '';
            if (type === 'error') {
                iconSvg = '<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#ef4444" stroke-width="2.5"><circle cx="12" cy="12" r="10"></circle><line x1="15" y1="9" x2="9" y2="15"></line><line x1="9" y1="9" x2="15" y2="15"></line></svg>';
            } else if (type === 'success') {
                iconSvg = '<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#10b981" stroke-width="2.5"><circle cx="12" cy="12" r="10"></circle><polyline points="9 11 12 14 22 4"></polyline></svg>';
            } else {
                iconSvg = '<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#0ea5e9" stroke-width="2.5"><circle cx="12" cy="12" r="10"></circle><line x1="12" y1="16" x2="12" y2="12"></line><line x1="12" y1="8" x2="12.01" y2="8"></line></svg>';
            }

            toast.innerHTML = `
                <div class="toast-icon">${iconSvg}</div>
                <div class="toast-body">${message}</div>
                <button type="button" class="toast-close-btn" onclick="this.parentElement.remove()">&times;</button>
            `;

            container.appendChild(toast);

            setTimeout(() => {
                toast.classList.add('toast-hiding');
                setTimeout(() => toast.remove(), 250);
            }, 3500);
        }

        function switchAuthTab(mode) {
            currentMode = mode;
            const tabSignUp = document.getElementById('tabSignUp');
            const tabSignIn = document.getElementById('tabSignIn');
            const submitBtn = document.getElementById('submitBtn');
            const nameGroup = document.getElementById('nameGroup');
            const usernameInput = document.getElementById('username');
            const phoneNumberInput = document.getElementById('phoneNumber');
            const authHeaderSubtitle = document.getElementById('authHeaderSubtitle');
            const phoneHelp = document.getElementById('phoneHelp');

            if (mode === 'signup') {
                tabSignUp.classList.add('active');
                tabSignIn.classList.remove('active');
                nameGroup.classList.remove('d-none');
                usernameInput.setAttribute('required', 'required');
                submitBtn.textContent = 'Sign Up & Start Chatting →';
                authHeaderSubtitle.textContent = 'Register with your mobile number to start direct chat or join rooms';
                phoneHelp.textContent = 'Enter your mobile number (7-15 digits with optional country code).';
                usernameInput.focus();
            } else {
                tabSignIn.classList.add('active');
                tabSignUp.classList.remove('active');
                nameGroup.classList.add('d-none');
                usernameInput.removeAttribute('required');
                submitBtn.textContent = 'Sign In with Mobile Number →';
                authHeaderSubtitle.textContent = 'Enter your registered mobile number to access your chats';
                phoneHelp.textContent = 'Only your mobile number is needed to log in.';
                phoneNumberInput.focus();
            }
        }

        document.getElementById('authForm').addEventListener('submit', async (e) => {
            e.preventDefault();

            const name = document.getElementById('username').value.trim();
            const phoneNumber = document.getElementById('phoneNumber').value.trim();

            if (!phoneNumber) {
                showToast('Please enter your mobile number.', 'error');
                return;
            }

            if (currentMode === 'signup' && (!name || name.length < 2)) {
                showToast('Please enter your full name (at least 2 characters).', 'error');
                return;
            }

            const endpoint = currentMode === 'signup' ? '/api/auth/signup' : '/api/auth/login';
            const payload = currentMode === 'signup' ? { name, phoneNumber } : { phoneNumber };

            const submitBtn = document.getElementById('submitBtn');
            submitBtn.disabled = true;

            try {
                const res = await fetch(endpoint, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(payload)
                });

                const data = await res.json();
                submitBtn.disabled = false;

                if (!res.ok || !data.success) {
                    showToast(data.error || 'Authentication failed. Please verify your details.', 'error');
                    return;
                }

                showToast(currentMode === 'signup' ? 'Account created successfully! Redirecting...' : 'Welcome back! Redirecting...', 'success');

                // Store registered user in localStorage
                localStorage.setItem('chat_user', JSON.stringify(data.user));

                // Navigate to chat dashboard after short delay for toast feedback
                setTimeout(() => {
                    window.location.href = `/chat?userId=${encodeURIComponent(data.user.id)}&username=${encodeURIComponent(data.user.name)}&phone=${encodeURIComponent(data.user.phoneNumber)}`;
                }, 400);
            } catch (err) {
                submitBtn.disabled = false;
                showToast('Network error connecting to server. Please try again.', 'error');
            }
        });
    </script>
</body>

</html>
