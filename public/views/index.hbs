<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="/assets/bootstrap/bootstrap.min.css">
    <link rel="stylesheet" href="/css/style.css">
    <title>Chat App - Join Chat</title>
</head>

<body>
    <div class="join-wrapper">
        <div class="join-card">
            <div class="join-card-header">
                <div class="join-brand-icon">
                    <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"></path>
                    </svg>
                </div>
                <h3>Join Chat</h3>
                <p>Connect with teams and friends in real-time rooms</p>
            </div>
            <div class="join-card-body">
                <form action="/chat" method="GET" autocomplete="off" id="joinForm">
                    <div class="mb-3">
                        <label for="username" class="form-label">Display Name</label>
                        <input type="text" class="form-control modern-input" id="username" name="username"
                            placeholder="e.g. Alex, Sarah" required autofocus>
                    </div>

                    <div class="mb-3">
                        <label for="room" class="form-label">Chat Room</label>
                        <input type="text" class="form-control modern-input" id="room" name="room" list="room-options"
                            placeholder="Select or enter room name" required>
                        <datalist id="room-options">
                            <option value="General"></option>
                            <option value="Tech"></option>
                            <option value="Cricket"></option>
                            <option value="Football"></option>
                            <option value="Political"></option>
                        </datalist>

                        <div class="room-tags-container">
                            <span class="text-muted" style="font-size: 0.75rem; align-self: center;">Popular:</span>
                            <button type="button" class="room-tag-btn" onclick="selectRoom('General')">#General</button>
                            <button type="button" class="room-tag-btn" onclick="selectRoom('Tech')">#Tech</button>
                            <button type="button" class="room-tag-btn" onclick="selectRoom('Cricket')">#Cricket</button>
                            <button type="button" class="room-tag-btn" onclick="selectRoom('Football')">#Football</button>
                            <button type="button" class="room-tag-btn" onclick="selectRoom('Political')">#Political</button>
                        </div>
                    </div>

                    <div class="d-grid mt-4">
                        <button type="submit" class="btn btn-primary-gradient">
                            Enter Chat Room &rarr;
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <script>
        function selectRoom(roomName) {
            const roomInput = document.getElementById('room');
            if (roomInput) {
                roomInput.value = roomName;
                const usernameInput = document.getElementById('username');
                if (!usernameInput.value) {
                    usernameInput.focus();
                }
            }
        }
    </script>
</body>

</html>
